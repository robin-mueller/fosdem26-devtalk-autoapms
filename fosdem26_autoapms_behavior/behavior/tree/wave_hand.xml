<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="WaveHand">
  <BehaviorTree ID="SimpleLeftRight">
    <KeepRunningUntilFailure>
      <Sequence>
        <MoveLeft/>
        <RetryUntilSuccessful num_attempts="-1">
          <HandIsFarLeft/>
        </RetryUntilSuccessful>
        <MoveRight/>
        <RetryUntilSuccessful num_attempts="-1">
          <HandIsFarRight/>
        </RetryUntilSuccessful>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="WaveHand">
    <KeepRunningUntilFailure>
      <Sequence>
        <VelocityPub velocity="1.0"/>
        <Sleep msec="500"/>
        <VelocityPub velocity="0.0"/>
        <Sleep msec="100"/>
        <VelocityPub velocity="-1.0"/>
        <Sleep msec="1000"/>
        <VelocityPub velocity="0.0"/>
        <Sleep msec="100"/>
        <VelocityPub velocity="1.0"/>
        <Sleep msec="500"/>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="HandIsFarLeft"/>
    <Condition ID="HandIsFarRight"/>
    <Condition ID="MoveLeft"/>
    <Condition ID="MoveRight"/>
    <Condition ID="VelocityPub">
      <input_port name="velocity"
                  default="0.000000"
                  type="double">Velocity command (-1.0 to 1.0)</input_port>
    </Condition>
  </TreeNodesModel>

</root>
